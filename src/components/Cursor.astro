---
// The thread-and-bead cursor drawn over the page (decorative).
---
<svg class="cur-svg" aria-hidden="true" width="100%" height="100%" style="position: fixed; left: 0; top: 0; width: 100vw; height: 100vh; z-index: 60; pointer-events: none; opacity: 0; overflow: visible; transition: opacity .25s ease;">
  <path class="cur-glow" d="M-9 -9" fill="none" stroke="rgba(178,58,31,.28)" stroke-width="8" stroke-linecap="round"></path>
  <path class="cur-red" d="M-9 -9" fill="none" stroke="#B23A1F" stroke-width="2.4" stroke-linecap="round"></path>
  <path class="cur-yel" d="M-9 -9" fill="none" stroke="#E3B04B" stroke-width="2.4" stroke-dasharray="3 7" stroke-linecap="round"></path>
  <circle class="cur-pulse" cx="-99" cy="-99" r="8" fill="none" stroke="#F2CD7A" stroke-width="1.5" opacity="0"></circle>
  <g class="cur-bead" transform="translate(-99 -99)">
    <circle class="cur-ring" r="7" fill="none" stroke="#E3B04B" stroke-width="1.2" opacity="0"></circle>
    <circle r="4" fill="#F7E2A8" stroke="#B23A1F" stroke-width="1.2" style="filter: drop-shadow(0 0 6px rgba(227,176,75,.85));"></circle>
  </g>
</svg>
<script>
  import { initCursor } from '../islands/cursor';
  initCursor();
</script>
