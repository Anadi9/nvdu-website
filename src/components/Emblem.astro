---
// The Vedshala's line glyphs, ported from design/prototype/Emblem.dc.html.
// Stroke width keeps the same visual weight at every size.
interface Props { glyph?: string; size?: number; color?: string; label?: string }
const { glyph = 'yantra', size = 64, color = 'currentColor' } = Astro.props;
const px = size <= 20 ? 2.4 : size <= 32 ? 2 : size <= 56 ? 1.5 : 1.2;
const sw = (px * 64 / size).toFixed(2);
const LABELS: Record<string, string> = { yantra: 'Yantra, the instrument', patra: 'Patra, the leaf on its cord', sangam: 'Sangam, two streams', siddhanta: 'Siddhanta, dividers', samhita: 'Samhita, sun over fields', hora: 'Hora, the kundali', nakshatra: 'Nakshatra', graha: 'Graha', rashi: 'Rashi', tithi: 'Tithi', ayanamsha: 'Ayanamsha', yuga: 'Yuga', mark: 'Nakshatra Vedshala' };
const label = Astro.props.label ?? LABELS[glyph] ?? glyph;
---
<span role="img" aria-label={label} style={`display: inline-block; width: ${size}px; height: ${size}px; line-height: 0; color: ${color}; vertical-align: middle; flex: 0 0 auto;`}>
  <svg viewBox="0 0 64 64" width="100%" height="100%" fill="none" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {glyph === 'yantra' && <Fragment set:html={'<circle cx="32" cy="36" r="21"/><ellipse cx="32" cy="36" rx="21" ry="9" transform="rotate(-28 32 36)"/><path d="M21 13l24 48"/><circle cx="32" cy="36" r="3"/><path d="M28 8h8l-4 5z"/>'} />}
    {glyph === 'patra' && <Fragment set:html={'<rect x="8" y="17" width="48" height="12" rx="6"/><circle cx="15" cy="23" r="2"/><circle cx="49" cy="23" r="2"/><path d="M21 21h18M21 25h13"/><path d="M8 35h46M8 40h42"/><path d="M15 25v30"/><circle cx="15" cy="57" r="2"/>'} />}
    {glyph === 'sangam' && <Fragment set:html={'<path d="M12 12c0 14 8 24 20 28c12-4 20-14 20-28"/><path d="M32 40v15M24 55h16"/><path d="M32 8l1.6 4.4 4.4 1.6-4.4 1.6-1.6 4.4-1.6-4.4-4.4-1.6 4.4-1.6z"/>'} />}
    {glyph === 'siddhanta' && <Fragment set:html={'<circle cx="32" cy="10" r="2.5"/><path d="M31 12.5L20 50M33 12.5L44 50"/><path d="M24.5 35h15"/><path d="M14 51c8 4.5 28 4.5 36 0"/>'} />}
    {glyph === 'samhita' && <Fragment set:html={'<path d="M24 34a8 8 0 0 1 16 0"/><path d="M12 34h40"/><path d="M32 19v4M22 23l2.5 3M42 23l-2.5 3M15 29h3M46 29h3"/><path d="M16 40c3-2 6-2 9 0s6 2 9 0 6-2 9 0 6-2 6 0"/><path d="M22 46c3-2 6-2 9 0s6 2 9 0"/>'} />}
    {glyph === 'hora' && <Fragment set:html={'<rect x="11" y="11" width="42" height="42"/><path d="M11 11l42 42M53 11L11 53M32 11l21 21-21 21-21-21z"/>'} />}
    {glyph === 'nakshatra' && <Fragment set:html={'<circle cx="32" cy="33" r="20"/><circle cx="32" cy="33" r="8"/><path d="M32 28l1.2 3.8 3.8 1.2-3.8 1.2-1.2 3.8-1.2-3.8-3.8-1.2 3.8-1.2z"/><path d="M30 13h4v6h-4z" fill="currentColor"/>'} />}
    {glyph === 'graha' && <Fragment set:html={'<circle cx="32" cy="32" r="20" stroke-dasharray="2 3.2"/><circle cx="32" cy="32" r="9"/><circle cx="32" cy="32" r="2.5"/><circle cx="51" cy="32" r="3" fill="currentColor"/>'} />}
    {glyph === 'rashi' && <Fragment set:html={'<circle cx="32" cy="32" r="20"/><circle cx="32" cy="32" r="11"/><path d="M43 32h9M41.5 37.5l7.8 4.5M37.5 41.5l4.5 7.8M32 43v9M26.5 41.5l-4.5 7.8M22.5 37.5l-7.8 4.5M21 32h-9M22.5 26.5l-7.8-4.5M26.5 22.5l-4.5-7.8M32 21v-9M37.5 22.5l4.5-7.8M41.5 26.5l7.8-4.5"/><circle cx="32" cy="32" r="1.8" fill="currentColor"/>'} />}
    {glyph === 'tithi' && <Fragment set:html={'<path d="M33 14a18 18 0 1 0 0 36a12 18 0 1 1 0-36z"/><circle cx="44" cy="22" r="1.8" fill="currentColor"/><circle cx="46" cy="32" r="1.8" fill="currentColor"/><circle cx="44" cy="42" r="1.8" fill="currentColor"/>'} />}
    {glyph === 'ayanamsha' && <Fragment set:html={'<circle cx="32" cy="33" r="20"/><path d="M32 33l4-19"/><circle cx="32" cy="33" r="2" fill="currentColor"/><path d="M30 13h4v5h-4z" fill="currentColor"/>'} />}
    {glyph === 'yuga' && <Fragment set:html={'<circle cx="32" cy="32" r="20"/><path d="M32 18a14 14 0 1 1-13.5 10.5"/><path d="M32 24a8 8 0 1 1-7.7 5.9"/>'} />}
    {glyph === 'mark' && <Fragment set:html={'<circle cx="32" cy="33" r="19"/><circle cx="32" cy="33" r="11" stroke-dasharray="2 2.8"/><path d="M32 29l1 3 3 1-3 1-1 3-1-3-3-1 3-1z"/><circle cx="32" cy="14" r="2.8" fill="currentColor"/>'} />}
  </svg>
</span>
