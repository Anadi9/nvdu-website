---
// Ported from the prototype board "notfound" (src/boards/notfound.*). Generated by scripts/new-page.py.
import BaseLayout from '../layouts/BaseLayout.astro';
import Board from '../components/Board.astro';
import tpl from '../boards/notfound.html?raw';
import make from '../boards/notfound.js';
import '../styles/pages/notfound.css';
---
<BaseLayout title="Nakshatra Vedshala · Page not found" description="This leaf isn't in the bundle. The page may have moved, or the link may be mistyped." current="none" bare>
  <Board tpl={tpl} make={make} />
</BaseLayout>
<script>
  import { boot } from '../lib/dc/boot.js';
  import tpl from '../boards/notfound.html?raw';
  import make from '../boards/notfound.js';
  boot(tpl, make);
</script>
