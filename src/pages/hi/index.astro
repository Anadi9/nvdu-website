---
// Ported from the prototype board "homehi" (src/boards/homehi.*). Generated by scripts/new-page.py.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Board from '../../components/Board.astro';
import tpl from '../../boards/homehi.html?raw';
import make from '../../boards/homehi.js';
import '../../styles/pages/homehi.css';
---
<BaseLayout title="नक्षत्र वेधशाला · मुखपृष्ठ" description="दो नदियों के सङ्गम के ऊपर एक वेधशाला और पत्रों का पुस्तकालय, जिसे 1946 से जोशी परिवार सँभाल रहा है।" current="home" lang="hi" bare>
  <Board tpl={tpl} make={make} />
</BaseLayout>
<script>
  import * as THREE from 'three';
  import { boot } from '../../lib/dc/boot.js';
  import tpl from '../../boards/homehi.html?raw';
  import make from '../../boards/homehi.js';
  (window as any).THREE = THREE;
  boot(tpl, make);
</script>
