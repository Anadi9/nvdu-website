---
// Home, ported from design/prototype/HomeSutra.dc.html
import BaseLayout from '../layouts/BaseLayout.astro';
import Board from '../components/Board.astro';
import tpl from '../boards/home.html?raw';
import make from '../boards/home.js';
import '../styles/pages/home.css';
---
<BaseLayout title="Nakshatra Vedshala · Home" current="home" bare>
  <Board tpl={tpl} make={make} />
</BaseLayout>
<script>
  import * as THREE from 'three';
  import { boot } from '../lib/dc/boot.js';
  import tpl from '../boards/home.html?raw';
  import make from '../boards/home.js';
  (window as any).THREE = THREE;
  boot(tpl, make);
</script>
