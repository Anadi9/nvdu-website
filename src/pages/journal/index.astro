---
// Ported from the prototype board "journal" (src/boards/journal.*). Generated by scripts/new-page.py.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Board from '../../components/Board.astro';
import tpl from '../../boards/journal.html?raw';
import make from '../../boards/journal.js';
import '../../styles/pages/journal.css';
---
<BaseLayout title="Nakshatra Vedshala · Journal" description="Notes from the hill: sky guides, stories from the collection and explainers from the keepers. Each note carries the Moon as it was on the night it was written." current="journal" bare>
  <Board tpl={tpl} make={make} />
</BaseLayout>
<script>
  import * as THREE from 'three';
  import { boot } from '../../lib/dc/boot.js';
  import tpl from '../../boards/journal.html?raw';
  import make from '../../boards/journal.js';
  (window as any).THREE = THREE;
  boot(tpl, make);
</script>
