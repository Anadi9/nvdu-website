---
// The 27 Nakshatras, ported from design/prototype/Nakshatra.dc.html
import BaseLayout from '../../layouts/BaseLayout.astro';
import Board from '../../components/Board.astro';
import tpl from '../../boards/nakshatra.html?raw';
import make from '../../boards/nakshatra.js';
import '../../styles/pages/nakshatra.css';
---
<BaseLayout title="Nakshatra Vedshala · The 27 Nakshatras" description="The 27 mansions of the Moon as seen from Devprayag tonight: each Nakshatra's deity, junction star, lord, and when the Moon and Sun next pass through it." current="nakshatra" bare>
  <script slot="head" is:inline defer src="/vendor/astronomy.browser.min.js"></script>
  <Board tpl={tpl} make={make} />
</BaseLayout>
<script>
  import * as THREE from 'three';
  import { boot } from '../../lib/dc/boot.js';
  import tpl from '../../boards/nakshatra.html?raw';
  import make from '../../boards/nakshatra.js';
  (window as any).THREE = THREE;
  boot(tpl, make);
</script>
